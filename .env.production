# Production Environment Variables
# Copy this file and replace with your actual production values

# Server Configuration
PORT=5000
NODE_ENV=production
BASE_URL=https://your-app-name.vercel.app

# MongoDB Configuration (REQUIRED)
# Use MongoDB Atlas for production
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/gsams?retryWrites=true&w=majority

# JWT Secret (REQUIRED - Generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Twilio Configuration (Optional - for SMS features)
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# Redis Configuration (Optional - for caching)
# REDIS_URL=redis://default:password@host:port
