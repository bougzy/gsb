{
  "watch": [
    "index.js",
    "public/**/*",
    ".env"
  ],
  "ext": "js,json,html,css",
  "ignore": [
    "node_modules/**",
    "*.log",
    "*.md",
    "test-*.js"
  ],
  "env": {
    "NODE_ENV": "development"
  },
  "delay": 1000,
  "verbose": true,
  "restartable": "rs",
  "execMap": {
    "js": "node"
  }
}
